IDO_USERNAME='your-login-or-email'
IDO_PASSWORD='your-literal-password'

# Local execution defaults to stdio. Containers override this to streamable-http.
MCP_TRANSPORT='stdio'
MCP_HOST='127.0.0.1'
MCP_PORT='8000'
MCP_PATH='/mcp'

# Exact Host header values accepted by the HTTP transport.
MCP_ALLOWED_HOSTS='localhost,localhost:*,127.0.0.1,127.0.0.1:*'
